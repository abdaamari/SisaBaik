# Supabase Configuration
# Dapatkan dari Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (opsional)
# Hanya digunakan di server-side untuk verifikasi role admin dan bypass RLS
# JANGAN jamais expose ke browser. Isi di .env.local, bukan di sini.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin email allowlist (opsional, comma separated)
# Contoh: ADMIN_EMAILS=admin@sisabaik.id,superadmin@sisabaik.id
# ADMIN_EMAILS=admin@sisabaik.id